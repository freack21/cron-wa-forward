# Login with a pairing code instead of a QR code (phone number of the bot, country code + digits)
PAIRING_PHONE=
SESSION=forwarder
DATA_DIR=data

# Schedules follow this time zone (15m runs at :00 :15 :30 :45 local time)
TZ=Asia/Jakarta
# Numbers written as 08... get this country code
COUNTRY_CODE=62

# Anti-spam: shortest interval, and the default pause between two chats of one run
# (FORWARD_GAP_MS + random extra up to FORWARD_GAP_JITTER_MS; change it from chat with .delay)
MIN_INTERVAL_MIN=5
FORWARD_GAP_MS=5000
FORWARD_GAP_JITTER_MS=5000
# Upload the stored media again when WhatsApp's copy is this old
MEDIA_REFRESH_DAYS=7

WA_LOGGING=false
